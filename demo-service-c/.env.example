# Hosted deployment only. Set these privately in Vercel; never use NEXT_PUBLIC_ for credentials.
SERVICE_C_ORIGIN=https://your-service-c.example
AGENTIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# For local development, use SERVICE_C_ORIGIN=http://127.0.0.1:8807 and omit both Redis variables.

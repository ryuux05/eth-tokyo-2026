{
  "name": "agentic-world",
  "private": true,
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/sdk/core.d.ts",
      "default": "./dist/sdk/core.js"
    },
    "./agent": {
      "types": "./dist/sdk/agent.d.ts",
      "default": "./dist/sdk/agent.js"
    },
    "./service": {
      "types": "./dist/sdk/service.d.ts",
      "default": "./dist/sdk/service.js"
    }
  },
  "scripts": {
    "build": "hardhat build && npm run build:sdk && npm run build:mcp && npm run build:portal && npm run build:demo-service && npm run build:demo-service-b",
    "build:demo": "hardhat build && npm run build:demo-service && npm run build:demo-service-b",
    "build:sdk": "tsc --project tsconfig.sdk.json",
    "build:mcp": "tsc --project tsconfig.mcp.json",
    "build:signer": "node --import tsx scripts/build-signer.ts",
    "build:signer:windows": "node --import tsx scripts/build-signer.ts --package-windows",
    "verify:signer:windows": "node --import tsx scripts/build-signer.ts --verify-windows-bundle",
    "serve:mcp": "node dist/mcp/server.js",
    "build:portal": "esbuild portal/main.ts portal/styles.css portal/index.html --bundle --platform=browser --format=esm --outdir=portal/dist --loader:.html=copy",
    "serve:portal": "python3 -m http.server 4173 --directory portal/dist",
    "build:demo-service": "esbuild demo-service/app.ts demo-service/styles.css demo-service/index.html --bundle --platform=browser --format=esm --outdir=demo-service/dist --loader:.html=copy",
    "build:demo-service-b": "esbuild demo-service-b/app.ts demo-service-b/styles.css demo-service-b/index.html --bundle --platform=browser --format=esm --outdir=demo-service-b/dist --loader:.html=copy",
    "serve:demo-service": "node --import tsx demo-service/server.ts",
    "deploy:local-service": "hardhat run scripts/deploy-local-service.ts --network localhost",
    "demo": "node --import tsx scripts/demo.ts",
    "demo:local": "hardhat run scripts/local-e2e.ts --network localhost",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "^0.8.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "@noble/curves": "^1.9.0",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "hardhat": "^3.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.56.9"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  }
}
